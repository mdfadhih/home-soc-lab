<!-- Custom Wazuh Rule: Enhanced Brute Force Detection -->
<!-- Author: Mohamed Fadhih | Home SOC Lab -->
<!-- MITRE ATT&CK: T1110 - Brute Force -->

<group name="custom_soc_lab,authentication,">

  <!-- Rule 1: Multiple failed logons in 2 minutes (enhanced threshold) -->
  <rule id="100001" level="10" frequency="8" timeframe="120">
    <if_matched_sid>60122</if_matched_sid>
    <same_field>win.system.computer</same_field>
    <description>Multiple Windows logon failures detected - Possible brute force attack (T1110)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,brute_force,</group>
  </rule>

  <!-- Rule 2: Brute force from same source IP -->
  <rule id="100002" level="12" frequency="15" timeframe="60">
    <if_matched_sid>60122</if_matched_sid>
    <same_field>win.eventdata.ipAddress</same_field>
    <description>High frequency logon failures from same IP - Active brute force (T1110)</description>
    <mitre>
      <id>T1110</id>
      <id>T1078</id>
    </mitre>
    <group>authentication_failures,brute_force,high_severity,</group>
  </rule>

</group>
