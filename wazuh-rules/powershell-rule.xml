<!-- Custom Wazuh Rule: Suspicious PowerShell Detection -->
<!-- Author: Mohamed Fadhih | Home SOC Lab -->
<!-- MITRE ATT&CK: T1059.001 - PowerShell -->

<group name="custom_soc_lab,powershell,">

  <!-- Rule: Suspicious PowerShell execution flags -->
  <rule id="100003" level="10">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)powershell\.exe</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(bypass|hidden|encodedcommand|iex|invoke-expression|downloadstring|webclient)</field>
    <description>Suspicious PowerShell execution with evasion flags detected (T1059.001)</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
    <group>powershell,execution,suspicious,</group>
  </rule>

  <!-- Rule: PowerShell encoded command -->
  <rule id="100004" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)powershell\.exe</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)-enc|-encodedcommand</field>
    <description>PowerShell encoded command execution - High risk evasion technique (T1059.001)</description>
    <mitre>
      <id>T1059.001</id>
      <id>T1027</id>
    </mitre>
    <group>powershell,encoded,high_severity,</group>
  </rule>

</group>
